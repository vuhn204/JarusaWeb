# Configuración opcional del backend. Ninguna variable es obligatoria.
# Para cambiarlas, copia este archivo como .env y edita los valores.
# No contiene ni debe contener secretos.

# Puerto de la API Express (el proxy de Vite usa el mismo valor)
PORT=3001

# Ruta del archivo SQLite, relativa a la carpeta del proyecto
JARUSA_DB=server/data/jarusa.db
